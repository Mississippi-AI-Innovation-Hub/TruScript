# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="MSBN Transcript Verification API"
APP_VERSION=0.1.0
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_32_byte_hex_secret

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used by the application (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://msbn_user:msbn_pass@localhost:5432/msbn_poc
# Sync URL used by Alembic internals (psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://msbn_user:msbn_pass@localhost:5432/msbn_poc

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/msbn_uploads
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png","image/tiff"]

# ── Keycloak Authentication ───────────────────────────────────────────────────
# URL where Keycloak is running (use http://keycloak:8080 inside Docker)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=msbn
KEYCLOAK_CLIENT_ID=msbn-api
# Rotate this secret in any non-local environment
KEYCLOAK_CLIENT_SECRET=msbn-api-secret-change-in-prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
