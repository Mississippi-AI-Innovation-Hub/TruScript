# ============================================================
# HOW TO USE THIS FILE
# ============================================================
# 1. Copy to terraform.tfvars:
#      cp terraform.tfvars.example terraform.tfvars
#
# 2. Replace every  TODO: ...  value below
#
# 3. This file is gitignored — your real values stay local
# ============================================================

# ── AWS ──────────────────────────────────────────────────────────────────────
# Get from: AWS Console top-right dropdown
aws_region = "us-east-1"

# Get from: AWS Console top-right corner (12-digit number)
aws_account_id = "TODO: 123456789012"

# ── Environment ───────────────────────────────────────────────────────────────
env = "dev"

# ── Networking ────────────────────────────────────────────────────────────────
vpc_cidr = "10.0.0.0/16"

# ── Database ──────────────────────────────────────────────────────────────────
db_name           = "msbn_db"
db_username       = "msbn_user"

# Make this strong — min 16 chars, mix of letters/numbers/symbols
db_password = "TODO: MyStr0ng!DBPass2026"

db_instance_class = "db.t3.micro"

# ── App Secrets ───────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
app_secret_key = "TODO: paste-64-char-hex-string-here"

# Get from: Keycloak Admin Console → Clients → msbn-api → Credentials
keycloak_client_secret = "TODO: keycloak-client-secret-from-console"

# Keycloak admin login password (you set this yourself)
keycloak_admin_password = "TODO: Admin@MSBN2026!"

# ── Container Images ──────────────────────────────────────────────────────────
# These will be updated to real tags after first ECR push
api_image_tag      = "latest"
keycloak_image_tag = "latest"

# ── ECS Sizing (keep small for dev) ──────────────────────────────────────────
api_cpu           = 512
api_memory        = 1024
api_desired_count = 1
keycloak_cpu      = 512
keycloak_memory   = 1024

# ── ML ────────────────────────────────────────────────────────────────────────
# Claude Haiku is cheapest for dev testing
bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# Leave empty until you train a Rekognition model (optional for Phase 1)
rekognition_project_version_arn = ""

# Leave empty on first apply — fill in AFTER terraform apply prints alb_dns_name
# Example: "http://msbn-dev-alb-1234567890.us-east-1.elb.amazonaws.com"
api_internal_url = ""

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
api_callback_secret = "TODO: paste-64-char-hex-string-here"

# ── Misc ──────────────────────────────────────────────────────────────────────
allowed_origins    = "http://localhost:5173,http://localhost:3000"
log_retention_days = 7
