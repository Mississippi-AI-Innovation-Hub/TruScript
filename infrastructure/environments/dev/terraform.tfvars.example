# Copy this file to terraform.tfvars and fill in all TODO values.
# terraform.tfvars is gitignored — never commit real secrets.
#
# Usage:
#   cd infrastructure/backend
#   terraform init
#   terraform apply -var-file="../environments/dev/terraform.tfvars"
#
#   cd infrastructure/frontend
#   terraform init
#   terraform apply -var-file="../environments/dev/terraform.tfvars"

# ── AWS ──────────────────────────────────────────────────────────────────────
aws_region     = "us-east-1"
aws_account_id = "TODO: 123456789012"   # Your 12-digit AWS account ID

# ── Environment ───────────────────────────────────────────────────────────────
env = "dev"

# ── Networking ────────────────────────────────────────────────────────────────
vpc_cidr = "10.0.0.0/16"

# ── Database ──────────────────────────────────────────────────────────────────
db_name           = "msbn_db"
db_username       = "msbn_user"
db_password       = "TODO: replace-with-strong-password-min-16-chars"
db_instance_class = "db.t3.micro"

# ── App Secrets ───────────────────────────────────────────────────────────────
app_secret_key          = "TODO: replace-with-32-char-minimum-secret-key-here"
keycloak_client_secret  = "TODO: replace-with-keycloak-client-secret"
keycloak_admin_password = "TODO: replace-with-keycloak-admin-password"

# ── Container Images ──────────────────────────────────────────────────────────
# After pushing to ECR, update these tags to deploy specific versions
api_image_tag      = "latest"
keycloak_image_tag = "latest"

# ── ECS Sizing ────────────────────────────────────────────────────────────────
api_cpu           = 512
api_memory        = 1024
api_desired_count = 1
keycloak_cpu      = 512
keycloak_memory   = 1024

# ── ML ────────────────────────────────────────────────────────────────────────
# Haiku is cheaper for dev; use Sonnet/Claude 3.5 for prod
bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# ── Misc ──────────────────────────────────────────────────────────────────────
allowed_origins    = "http://localhost:5173,http://localhost:3000"
log_retention_days = 7
